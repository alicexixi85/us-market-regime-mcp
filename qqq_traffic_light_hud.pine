// QQQ Regime HUD: a simplified, chart-only version of the end-of-day regime published at signal.usethelever.com
// Educational market context only. Not investment advice and not a buy/sell signal.
// MIT License
//@version=6
indicator("QQQ Traffic Light Regime HUD [UseTheLever]", overlay=true)

tf_input   = input.timeframe("D", "QQQ Regime Timeframe")
hud_pos    = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left"])

[qqq_close, qqq_high, qqq_low, qqq_ema21, qqq_ema50, qqq_atr, qqq_atr_sma, qqq_rsi] = request.security(
     "NASDAQ:QQQ",
     tf_input,
     [close, high, low, ta.ema(close, 21), ta.ema(close, 50), ta.atr(14), ta.sma(ta.atr(14), 20), ta.rsi(close, 14)],
     lookahead=barmerge.lookahead_off
)

net_move   = math.abs(qqq_close - qqq_close[10])
total_path = math.sum(qqq_high - qqq_low, 10)
efficiency = total_path != 0 ? (net_move / total_path) : 0.5

is_uptrend   = qqq_close > qqq_ema21 and qqq_ema21 > qqq_ema50
is_downtrend = qqq_close < qqq_ema50 and qqq_ema21 < qqq_ema50
is_wide_chop = (qqq_atr > qqq_atr_sma * 1.05 and efficiency < 0.35) or (qqq_close < qqq_ema21 and qqq_close >= qqq_ema50)

string light_status = "🟡 YELLOW: CHOPPY / MIXED"
string context_note = "Wide range or mixed trend; follow-through has been less reliable"
color  bg_color     = color.new(#D97706, 15)

if is_uptrend and not is_wide_chop and qqq_rsi > 52
    light_status := "🟢 GREEN: TREND SUPPORTIVE"
    context_note := "QQQ above rising 21/50 EMA, range efficiency normal"
    bg_color     := color.new(#059669, 15)
else if is_downtrend and not is_wide_chop
    light_status := "🔴 RED: DOWNTREND"
    context_note := "QQQ below falling 21/50 EMA"
    bg_color     := color.new(#DC2626, 15)

var pos = hud_pos == "Top Right" ? position.top_right : hud_pos == "Bottom Right" ? position.bottom_right : position.top_left
var table hud = table.new(pos, 1, 3, border_width=1, border_color=color.new(color.white, 70))

if barstate.islast
    table.cell(hud, 0, 0, "QQQ REGIME: " + light_status, text_color=color.white, bgcolor=bg_color, text_size=size.normal)
    table.cell(hud, 0, 1, "Context: " + context_note, text_color=color.white, bgcolor=color.new(#1E293B, 10), text_size=size.small)
    table.cell(hud, 0, 2, "Educational context only, not a trade signal | signal.usethelever.com", text_color=color.new(color.silver, 5), bgcolor=color.new(#0F172A, 15), text_size=size.tiny)
