//@version=5
// Whetstone U.S. Market Regime & Distribution Day Filter
// Educational market-environment context only. Not investment advice, not a security recommendation, and zero buy/sell signals.
// License: Mozilla Public License 2.0 / MIT (Open Source)

indicator("Whetstone U.S. Market Regime & Distribution Day Filter", shorttitle="Whetstone Regime HUD", overlay=true, max_bars_back=500)

// -----------------------------------------------------------------------------
// 1. Inputs
// -----------------------------------------------------------------------------
grp_ma = "Moving Averages & Trend"
show_mas = input.bool(true, "Plot EMA 21 / SMA 50 / SMA 200", group=grp_ma)

grp_dist = "Institutional Distribution Filter"
dist_window        = input.int(25, "Rolling Distribution Window (Bars)", minval=5, maxval=100, group=grp_dist)
dist_drop_pct      = input.float(0.2, "Min Down Close % for Distribution", minval=0.05, maxval=5.0, step=0.05, group=grp_dist)
yellow_dist_thresh = input.int(4, "Defensive Yellow Distribution Threshold", minval=1, maxval=15, group=grp_dist)
red_dist_thresh    = input.int(6, "Risk-Off Red Distribution Threshold", minval=2, maxval=20, group=grp_dist)

grp_vix = "Volatility Context (CBOE:VIX + Safe Fallback)"
use_vix    = input.bool(true, "Include CBOE:VIX Volatility Filter", group=grp_vix)
vix_symbol = input.string("CBOE:VIX", "Volatility Symbol", group=grp_vix)
vix_len    = input.int(20, "Volatility SMA Length", minval=5, maxval=100, group=grp_vix)

grp_hud = "HUD Table Display"
show_hud    = input.bool(true, "Show Regime HUD Table", group=grp_hud)
hud_pos_in  = input.string("Top Right", "HUD Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grp_hud)
hud_size_in = input.string("Small", "HUD Text Size", options=["Tiny", "Small", "Normal"], group=grp_hud)

// -----------------------------------------------------------------------------
// 2. Trend Structure (EMA 21, SMA 50, SMA 200) — Zero Repainting
// -----------------------------------------------------------------------------
ema21  = ta.ema(close, 21)
sma50  = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

plot(show_mas ? ema21  : na, "EMA 21",  color=color.new(#38BDF8, 15), linewidth=1)
plot(show_mas ? sma50  : na, "SMA 50",  color=color.new(#F59E0B, 15), linewidth=2)
plot(show_mas ? sma200 : na, "SMA 200", color=color.new(#94A3B8, 10), linewidth=2)

above_200      = not na(sma200) ? close > sma200 : close > sma50
pct_vs_sma200  = not na(sma200) and sma200 != 0.0 ? ((close - sma200) / sma200) * 100.0 : na
is_stacked_up  = close > ema21 and ema21 > sma50 and above_200
is_pullback_up = not is_stacked_up and close >= sma50 and above_200
is_below_200   = not above_200

string trend_structure = "Downtrend (Below SMA 50 & SMA 200)"
if is_stacked_up
    trend_structure := "Stacked Uptrend (Close > EMA21 > SMA50 > SMA200)"
else if is_pullback_up
    trend_structure := "Uptrend Pullback (Above SMA 50 & SMA 200)"
else if not is_below_200 and close < sma50
    trend_structure := "Intermediate Pullback (Below SMA 50, Above SMA 200)"
else if is_below_200 and close >= sma50
    trend_structure := "Counter-Trend Bounce (Above SMA 50, Below SMA 200)"

// -----------------------------------------------------------------------------
// 3. Rolling 25-Bar Institutional Distribution Day Count
//    Definition: close < close[1] by >= 0.2% on higher volume (volume > volume[1])
// -----------------------------------------------------------------------------
has_volume     = not na(volume) and not na(volume[1]) and volume > 0
bar_chg_pct    = not na(close[1]) and close[1] != 0.0 ? ((close - close[1]) / close[1]) * 100.0 : 0.0
is_dist_day    = has_volume and (bar_chg_pct <= -dist_drop_pct) and (volume > volume[1])
dist_count_25  = int(math.round(math.sum(is_dist_day ? 1.0 : 0.0, dist_window)))

// -----------------------------------------------------------------------------
// 4. Volatility Context: CBOE:VIX vs SMA(VIX, 20) with Safe ATR Fallback
// -----------------------------------------------------------------------------
vix_close = request.security(vix_symbol, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
vix_sma20 = ta.sma(vix_close, vix_len)
vix_valid = use_vix and not na(vix_close) and not na(vix_sma20) and vix_sma20 > 0.0

atr14          = ta.atr(14)
atr_sma20      = ta.sma(atr14, vix_len)
fallback_ratio = not na(atr_sma20) and atr_sma20 > 0.0 ? (atr14 / atr_sma20) : 1.0

vol_ratio    = vix_valid ? (vix_close / vix_sma20) : fallback_ratio
vol_elevated = vol_ratio > 1.05
vol_stressed = vol_ratio > 1.20 or (vix_valid and vix_close >= 25.0)

// -----------------------------------------------------------------------------
// 5. Deterministic Regime Classification & Educational Position Sizing Posture
// -----------------------------------------------------------------------------
is_red_regime   = is_below_200 or (has_volume and dist_count_25 >= red_dist_thresh) or (close < sma50 and vol_stressed)
is_green_regime = not is_red_regime and is_stacked_up and (not has_volume or dist_count_25 < yellow_dist_thresh) and not vol_elevated

string regime_label   = "DEFENSIVE YELLOW"
string sizing_posture = "Half Size"
color  regime_bg      = color.new(#B45309, 10)

if is_green_regime
    regime_label   := "GREEN"
    sizing_posture := "Normal 0.5R-1R"
    regime_bg      := color.new(#047857, 10)
else if is_red_regime
    regime_label   := "RISK-OFF RED"
    sizing_posture := "Cash & Patience"
    regime_bg      := color.new(#B91C1C, 10)

// -----------------------------------------------------------------------------
// 6. Top-Right HUD Table (Educational Rule Display Only — Zero Trade Signals)
// -----------------------------------------------------------------------------
hud_pos  = hud_pos_in == "Top Right" ? position.top_right : hud_pos_in == "Bottom Right" ? position.bottom_right : hud_pos_in == "Top Left" ? position.top_left : position.bottom_left
txt_size = hud_size_in == "Tiny" ? size.tiny : hud_size_in == "Small" ? size.small : size.normal

var table hud = table.new(hud_pos, 2, 7, border_width=1, border_color=color.new(#475569, 40), frame_width=1, frame_color=color.new(#64748B, 30))

if show_hud and barstate.islast
    header_bg = color.new(#0F172A, 8)
    row_bg    = color.new(#1E293B, 10)
    muted_bg  = color.new(#0F172A, 15)

    dist_text = has_volume ? (str.tostring(dist_count_25) + " / " + str.tostring(dist_window) + " bars") : "N/A (No Volume Feed)"
    sma200_suffix = not na(pct_vs_sma200) ? (" (" + (pct_vs_sma200 >= 0 ? "+" : "") + str.tostring(pct_vs_sma200, "#.##") + "% vs 200S)") : ""
    vol_text = vix_valid ? ("VIX " + str.tostring(vix_close, "#.##") + " vs SMA" + str.tostring(vix_len) + " " + str.tostring(vix_sma20, "#.##") + " (" + str.tostring(vol_ratio, "#.##") + "x)") : ("ATR Fallback Ratio: " + str.tostring(fallback_ratio, "#.##") + "x")
    bar_mode = barstate.isconfirmed ? "Confirmed Close" : "Live Intrabar"

    table.cell(hud, 0, 0, "WHETSTONE REGIME FILTER", text_color=color.white, bgcolor=header_bg, text_size=txt_size, text_halign=text.align_left)
    table.cell(hud, 1, 0, bar_mode, text_color=color.new(#CBD5E1, 0), bgcolor=header_bg, text_size=txt_size, text_halign=text.align_right)

    table.cell(hud, 0, 1, "Regime State", text_color=color.new(#CBD5E1, 0), bgcolor=row_bg, text_size=txt_size, text_halign=text.align_left)
    table.cell(hud, 1, 1, regime_label, text_color=color.white, bgcolor=regime_bg, text_size=txt_size, text_halign=text.align_right)

    table.cell(hud, 0, 2, "Distribution Days", text_color=color.new(#CBD5E1, 0), bgcolor=row_bg, text_size=txt_size, text_halign=text.align_left)
    table.cell(hud, 1, 2, dist_text, text_color=color.white, bgcolor=row_bg, text_size=txt_size, text_halign=text.align_right)

    table.cell(hud, 0, 3, "Trend Structure", text_color=color.new(#CBD5E1, 0), bgcolor=row_bg, text_size=txt_size, text_halign=text.align_left)
    table.cell(hud, 1, 3, trend_structure + sma200_suffix, text_color=color.white, bgcolor=row_bg, text_size=txt_size, text_halign=text.align_right)

    table.cell(hud, 0, 4, "Volatility vs 20d", text_color=color.new(#CBD5E1, 0), bgcolor=row_bg, text_size=txt_size, text_halign=text.align_left)
    table.cell(hud, 1, 4, vol_text, text_color=color.white, bgcolor=row_bg, text_size=txt_size, text_halign=text.align_right)

    table.cell(hud, 0, 5, "Sizing Posture (Rule)", text_color=color.new(#CBD5E1, 0), bgcolor=row_bg, text_size=txt_size, text_halign=text.align_left)
    table.cell(hud, 1, 5, sizing_posture, text_color=color.white, bgcolor=regime_bg, text_size=txt_size, text_halign=text.align_right)

    table.cell(hud, 0, 6, "Educational Rule Context", text_color=color.new(#94A3B8, 0), bgcolor=muted_bg, text_size=size.tiny, text_halign=text.align_left)
    table.cell(hud, 1, 6, "Zero Buy/Sell Signals | Not Advice", text_color=color.new(#94A3B8, 0), bgcolor=muted_bg, text_size=size.tiny, text_halign=text.align_right)
